# ===== 选一个 LLM 提供方 =====
# ollama  = 本地模型，免费离线（默认，推荐新手先用这个）
# deepseek = DeepSeek 官方 API，便宜，需申请 key
LLM_PROVIDER=ollama

# ===== Ollama（本地）=====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# ===== DeepSeek（需要申请 key）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
